                    "type": "file",
                    "name": "index.html",
                    "data": "<!DOCTYPE html>\n  <html lang=\"de\">\n  <head>\n    <meta charset=\"utf-8\">\n    <title>Example Corp</title>\n    <style>\n      *{margin:0;padding:0;box-sizing:border-box}\n      body{font-family:Arial,sans-serif;color:#333;font-size:14px}\n      header{background:#1a3a5c;color:#fff;padding:12px 16px;display:flex;align-items:baseline;gap:14px;flex-wrap:wrap}\n      header h1{font-size:1.3em}\n      header p{opacity:.75;font-size:.82em}\n      .hero{background:linear-gradient(135deg,#1a3a5c,#2a5298);color:#fff;padding:24px 16px;text-align:center}\n      .hero h2{font-size:1.3em;margin-bottom:8px}\n      .features{display:flex;flex-direction:column;gap:10px;padding:16px;background:#f5f7fa}\n      .card{background:#fff;border-radius:8px;padding:14px;box-shadow:0 2px 6px rgba(0,0,0,.1)}\n      .card h3{color:#2a5298;margin-bottom:5px;font-size:.92em}\n      .card p{font-size:.85em;line-height:1.5}\n      .info{background:#e8f0fe;padding:9px 16px;font-size:.76em;color:#555;border-top:3px solid #2a5298}\n      footer{background:#1a3a5c;color:#aaa;padding:9px 16px;font-size:.75em}\n    </style>\n  </head>\n  <body>\n    <header>\n      <h1>Example Corp</h1>\n      <p>Cloud &amp; Hosting seit 2026</p>\n    </header>\n    <div class=\"hero\">\n      <h2>Willkommen bei Example Corp - <br> Ihr zuverlässiger Hosting-Partner</h2>\n    </div>\n    <div class=\"features\">\n      <div class=\"card\">\n        <h3>Rechenzentrum DC-Alpha</h3>\n        <p>DC-Alpha im Backbone (AS65001) &mdash; weltweit über BGP erreichbar.</p>\n      </div>\n    </div>\n    <div class=\"info\">IPv4: 185.1.1.10 &nbsp;|&nbsp; IPv6: 2001:db8:1:1::10 &nbsp;|&nbsp; AS65001</div>\n    <footer>&copy; 2026 Example Corp</footer>\n  </body>\n  </html>\n",
