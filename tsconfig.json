{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noImplicitAny": true,
    "types": ["vite/client"],
    //"noEmit": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "types",
    "rootDir": "src"
  },
  "include": ["src/**/*.js", "src/global.d.ts"],
  "exclude": ["src/defaultsim.js"]
}
