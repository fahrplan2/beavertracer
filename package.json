{
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/sync-version.mjs",
    "prebuild": "node scripts/sync-version.mjs && mkdir -p public/wiregasm && find node_modules/@goodtools/wiregasm -maxdepth 10 \\( -name '*.wasm' -o -name '*.wasm.gz' -o -name '*.data' -o -name '*.data.gz' \\) -type f -exec cp -f {} public/wiregasm/ \\;",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:win": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "name": "beavertracer",
  "description": "",
  "version": "0.1.25-dev.20.d13371f",
  "main": "electron/main.cjs",
  "repository": {
