    "@tauri-apps/cli": "^2.11.2",
    "markdown-it": "^14.2.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "eu.chklein.networksim",
